{
  "name": "plain-desktop",
  "version": "1.3.0-beta.1",
  "private": true,
  "description": "A thoughtful desktop studio for the Plain programming language",
  "author": "Reuben",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.cjs",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:smoke": "npm run build && node scripts/smoke.cjs",
    "preview": "node scripts/preview.cjs",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "checksums": "node scripts/checksums.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "monaco-editor": "0.57.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "dompurify": "3.4.18",
    "app-builder-lib": {
      "minimatch": "11.0.9"
    },
    "@electron/universal": {
      "minimatch": "11.0.9"
    },
    "dir-compare": { "minimatch": "5.1.9" }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
