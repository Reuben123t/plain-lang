{
  "PLAIN Starter Template": {
    "prefix": ["starter", "plain", "template"],
    "body": [
      "# PLAIN Program",
      "Set ABC = Main",
      "",
      "x = ${1:100}",
      "y = ${2:25}",
      "say \"Result: \" + str((x + y) * 2)",
      "say \"${3:Ready for AI, Web Servers & Cybersecurity!}\"",
      "$0"
    ],
    "description": "Standard PLAIN starter template with Set ABC = Main"
  },
  "Set ABC Statement": {
    "prefix": ["setabc", "main"],
    "body": [
      "Set ABC = Main",
      "$0"
    ],
    "description": "Initialize PLAIN main execution block"
  },
  "Say Statement": {
    "prefix": ["say", "print"],
    "body": [
      "say \"$1\"$0"
    ],
    "description": "Print output to screen or terminal"
  },
  "Function Definition (Python Style)": {
    "prefix": ["def"],
    "body": [
      "def ${1:name}(${2:args}):",
      "\t${0:return None}"
    ],
    "description": "Define a Python-style function in PLAIN"
  },
  "Function Definition (PLAIN Style)": {
    "prefix": ["function", "fn"],
    "body": [
      "function ${1:name}(${2:args})",
      "\t${0}",
      "end"
    ],
    "description": "Define a PLAIN block function with end"
  },
  "If Statement": {
    "prefix": ["if", "ifelse"],
    "body": [
      "if ${1:condition}",
      "\t${2:# then block}",
      "otherwise",
      "\t${0:# else block}",
      "end"
    ],
    "description": "Conditional if-otherwise-end block"
  },
  "For Each Loop": {
    "prefix": ["for", "foreach"],
    "body": [
      "for each ${1:item} in ${2:list}",
      "\t${0:say str(item)}",
      "end"
    ],
    "description": "Iterate over a collection or list"
  },
  "Repeat Loop": {
    "prefix": ["repeat"],
    "body": [
      "repeat ${1:5} times",
      "\t${0:say \"Looping...\"}",
      "end"
    ],
    "description": "Repeat a block N times"
  },
  "While Loop": {
    "prefix": ["while"],
    "body": [
      "while ${1:condition}:",
      "\t${0:# loop body}"
    ],
    "description": "While loop condition"
  },
  "Cybersecurity Port Scanner": {
    "prefix": ["cyber_portscan", "portscan"],
    "body": [
      "import cyber",
      "ports = [21, 22, 80, 443, 8080]",
      "open_ports = cyber.port_scan(\"${1:127.0.0.1}\", ports)",
      "say \"Open Ports: \" + str(open_ports)$0"
    ],
    "description": "Scan TCP ports on target host"
  },
  "Cybersecurity Security Headers Audit": {
    "prefix": ["cyber_audit", "audit"],
    "body": [
      "import cyber",
      "audit = cyber.audit_security_headers(\"${1:https://google.com}\")",
      "say \"Score: \" + str(audit.score) + \"/100 (Grade: \" + audit.grade + \")\"$0"
    ],
    "description": "Audit HTTP security headers of target website"
  },
  "Cybersecurity CVE Threat Intel": {
    "prefix": ["cyber_cve", "cve"],
    "body": [
      "import cyber",
      "cve = cyber.cve_lookup(\"${1:CVE-2021-44228}\")",
      "say \"Threat ID: \" + cve.id + \" -> Severity: \" + cve.severity$0"
    ],
    "description": "Offline lookup for known CVE vulnerabilities"
  },
  "AI Neural Network Training": {
    "prefix": ["ai_neural_network", "neuralnet", "ai"],
    "body": [
      "nn = neural_network([2, 4, 1])",
      "inputs = [[0, 0], [0, 1], [1, 0], [1, 1]]",
      "targets = [[0], [1], [1], [0]]",
      "train_ai(nn, inputs, targets, 200)",
      "output = predict_ai(nn, [1, 0])",
      "say \"Prediction: \" + str(output)$0"
    ],
    "description": "Train a multi-layer perceptron neural network"
  },
  "Web Server Deployment": {
    "prefix": ["web_server", "server", "http"],
    "body": [
      "server = web_server(${1:8080})",
      "say \"PLAIN Web Server running on port ${1:8080}...\"$0"
    ],
    "description": "Launch a live HTTP web server"
  },
  "Read Text File": {
    "prefix": ["read_file", "readfile"],
    "body": [
      "content = read_file(\"${1:data.txt}\")",
      "say content$0"
    ],
    "description": "Read contents of a text file"
  },
  "Write Text File": {
    "prefix": ["write_file", "writefile"],
    "body": [
      "write_file(\"${1:output.txt}\", \"${2:Hello from PLAIN!}\")",
      "say \"File saved!\"$0"
    ],
    "description": "Write text data to a file"
  }
}
