{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PLAIN",
  "scopeName": "source.plain",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#function_defs" },
    { "include": "#set_statement" },
    { "include": "#set_abc_statement" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#keywords" },
    { "include": "#function_calls" },
    { "include": "#cyber_functions" },
    { "include": "#ai_functions" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.plain", "match": "#.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.plain",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            { "name": "constant.character.escape.plain", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.plain",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            { "name": "constant.character.escape.plain", "match": "\\\\." }
          ]
        }
      ]
    },
    "function_defs": {
      "patterns": [
        {
          "match": "^\\s*(?i:(def|fn|function|to))\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.function.plain" },
            "2": { "name": "entity.name.function.plain" }
          }
        }
      ]
    },
    "set_statement": {
      "patterns": [
        {
          "match": "\\b(?i:(set))\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.set.plain" },
            "2": { "name": "variable.other.readwrite.plain" }
          }
        }
      ]
    },
    "set_abc_statement": {
      "patterns": [
        { "name": "meta.assignment.set-abc.plain", "match": "^\\s*(?i:set)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?:=|\\bto\\b)\\s*([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "variable.other.readwrite.plain" }, "2": { "name": "string.unquoted.plain" } } }
      ]
    },
    "cyber_functions": {
      "patterns": [
        { "name": "support.function.cyber.plain", "match": "\\b(?i:port_scan|is_port_open|banner_grab|audit_security_headers|detect_sql_injection|detect_xss|check_password_strength|subnet_calculator|dns_resolve|cve_lookup)\\b" }
      ]
    },
    "ai_functions": {
      "patterns": [
        { "name": "support.function.ai.plain", "match": "\\b(?i:create_neural_network|train_neural_network|predict_neural_network|knn_classify|kmeans_cluster|train_logistic_regression|softmax|sigmoid|relu)\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.plain", "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.plain", "match": "\\b(?i:true|false)\\b" },
        { "name": "constant.language.null.plain", "match": "\\b(?i:nothing|null)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.plain",
          "match": "==|!=|<=|>=|<|>|\\b(?i:is\\s+not\\s+equal\\s+to|is\\s+equal\\s+to|is\\s+greater\\s+than|is\\s+less\\s+than|is\\s+at\\s+least|is\\s+at\\s+most|is\\s+not|is|equals)\\b"
        },
        {
          "name": "keyword.operator.assignment.plain",
          "match": "\\*\\*=|//=|\\+=|-=|\\*=|/=|%=|=(?!=|>)"
        },
        {
          "name": "keyword.operator.arithmetic.plain",
          "match": "\\*\\*|//|\\+|-|\\*|/|%|\\b(?i:plus|minus|times|divided\\s+by|remainder\\s+of)\\b"
        },
        {
          "name": "keyword.operator.logical.plain",
          "match": "\\b(?i:and|or|not)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.plain",
          "match": "\\b(?i:if|then|otherwise|else|end|repeat|while|for|each|in|to|give|back|return|def|fn|function|import|from|as|break|continue)\\b"
        },
        {
          "name": "keyword.other.plain",
          "match": "\\b(?i:set|say|show|ask|save|clear|screen|item|of|add|remove|wait)\\b"
        }
      ]
    },
    "function_calls": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "variable.other.object.plain" },
            "2": { "name": "punctuation.accessor.plain" },
            "3": { "name": "entity.name.function.call.plain" }
          }
        },
        {
          "name": "entity.name.function.call.plain",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.section.brackets.plain", "match": "[()\\[\\]{}]" },
        { "name": "punctuation.separator.plain", "match": "[,:.]" }
      ]
    },
    "identifiers": {
      "patterns": [
        { "name": "variable.other.readwrite.plain", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" }
      ]
    }
  }
}
