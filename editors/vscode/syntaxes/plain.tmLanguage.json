{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PLAIN",
  "scopeName": "source.plain",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#builtins" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.plain",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.plain",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.plain",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.plain",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.plain",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.plain",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.plain",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.plain",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.plain",
          "match": "\\b(nothing|null)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.plain",
          "match": "\\b(if|then|otherwise|else|end|repeat|while|times|for\\s+each|for|each|in|to|give\\s+back|give|back|wait)\\b"
        },
        {
          "name": "keyword.other.plain",
          "match": "\\b(set|to|say|show|ask|and\\s+save\\s+as|save|as|clear\\s+screen|clear|screen|item|of|add|remove|from)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.plain",
          "match": "\\b(is\\s+equal\\s+to|is\\s+not\\s+equal\\s+to|is\\s+greater\\s+than|is\\s+less\\s+than|is\\s+at\\s+least|is\\s+at\\s+most|is\\s+not|is|equals)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.plain",
          "match": "\\b(plus|minus|times|divided\\s+by|remainder\\s+of)\\b"
        },
        {
          "name": "keyword.operator.logical.plain",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.symbol.plain",
          "match": "(\\+|-|\\*|/|%|==|!=|<=|>=|<|>)"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.plain",
          "match": "\\b(count|first|last|item|sort|reverse|sum|average|highest|lowest|uppercase|lowercase|length|contains|replace|trim|starts_with|ends_with|starts\\s+with|ends\\s+with|to_number|to_text|to\\s+number|to\\s+text|round|floor|ceiling|absolute|minimum|maximum|random_between|random\\s+between|today|current_time|current\\s+time|days_between|days\\s+between|read_file|read\\s+file|write_file|write\\s+file|file_exists|file\\s+exists)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(to)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.plain" },
            "2": { "name": "entity.name.function.plain" }
          }
        }
      ]
    }
  }
}
