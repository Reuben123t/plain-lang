# Opt-in Node-only listener demo. Do not include in automatic example execution.
# Binds to loopback only and closes before exiting; port 8080 must be available.
# No scanning, public-IP lookup, or external HTTP requests are needed.

say "=== PLAIN Loopback Server Demo ==="

def handle_request(request):
    if request.path == "/api/status":
        return json_response({"status": "online", "engine": "PLAIN"})
    end
    return html_response("<h1>PLAIN local demo</h1>")
end

server_info = deploy_server(8080, handle_request, "127.0.0.1")
say "Loopback listener started."
server_stopped = stop_deployed_server()
say "Listener stopped: " + server_stopped
