# Opt-in trusted Node automation. Run from the repository root.
# Executes a local shell command and reads repository files; output varies.
# No files are created/deleted and no credentials or external hosts are used.

say "=== PLAIN Task Automation Suite ==="

log_info("Reading local development information...")

runtime_version = run_command("node --version")
say "Node runtime: " + runtime_version

plain_files = find_files("examples", ".plain")
say "Example files: " + count(plain_files)

manifest_checksum = checksum_file("package.json", "sha256")
say "package.json SHA-256: " + manifest_checksum

log_info("Local automation demonstration finished.")
say "=== Automation Suite Completed Successfully! ==="
