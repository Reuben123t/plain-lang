# Local neural-network teaching example; no network or file access.
# Random initialization/training means predictions vary; no accuracy guarantee.
# For a short stable contract check, run 20_neural_contract.plain instead.

say "=== PLAIN AI Neural Network Training ==="

# The paired-matrix object includes both inputs and targets.
dataset = {"inputs": [[0, 0], [0, 1], [1, 0], [1, 1]], "targets": [[0], [1], [1], [0]]}
net = create_neural_network([2, 4, 1], "sigmoid")
history = train_neural_network(net, dataset, 100, 0.2)
prediction = predict_neural_network(net, [0, 1])

say "Epochs: " + history.epochs
say "Reported training loss: " + history.final_loss
say "Prediction for [0, 1] (target 1): " + prediction[0]

# Bundled dataset helpers return the same paired-matrix contract.
iris_data = load_ai_dataset("iris")
say "Bundled iris sample rows: " + iris_data.sample_count
say "Demo finished; these values are not a benchmark."
